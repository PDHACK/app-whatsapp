# Generado por scripts/nuevo-cliente.ps1. No subir a git (tiene contraseñas).
CLIENT_SLUG=demo
CLIENT_NAME=Cliente Demo

# Perfil de túnel: tunnel (dominio propio con token) | quicktunnel (gratis, URL temporal) | vacío (sin túnel)
COMPOSE_PROFILES=quicktunnel
TUNNEL_TOKEN=

# Base de datos del cliente
POSTGRES_DB=chatbot
POSTGRES_USER=chatbot
POSTGRES_PASSWORD=cambiar

# Evolution API (WhatsApp)
EVOLUTION_PORT=8081
EVOLUTION_API_KEY=cambiar
EVOLUTION_INSTANCE=demo
EVOLUTION_DEVICE_NAME=Chatbot demo
EVOLUTION_PUBLIC_URL=http://localhost:8081

# n8n existente (nombre del contenedor en la red wa-net)
N8N_WEBHOOK_URL=http://n8n:5678/webhook/wa-demo
