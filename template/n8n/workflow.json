    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Arma la conversación para la IA: instrucciones + info del negocio + historial + mensaje nuevo.\nconst c = $json.ctx;\nlet system = c.system_prompt;\nif (c.knowledge) system += '\\n\\nInformación del negocio (usá solo esto para responder):\\n' + c.knowledge;\nif (c.name) system += `\\n\\nEl cliente se llama ${c.name}.`;\nsystem += '\\nSi el mensaje es un audio, imagen u otro archivo (aparece entre corchetes), explicá amablemente que por ahora solo podés leer texto.';\nconst messages = [{ role: 'system', content: system }, ...(c.history || []), { role: 'user', content: c.text }];\nreturn { json: {\n  jid: c.jid,\n  provider: c.ai_provider,\n  model: c.ai_model,\n  aiBody: { model: c.ai_model, messages, stream: false, think: false, options: { temperature: 0.4 } }\n} };"
      },
      "name": "Armar prompt",
      "type": "n8n-nodes-base.code",
