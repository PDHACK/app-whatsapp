    {
      "parameters": {
        "jsCode": "// Convierte el webhook de Evolution API en un item simple.\n// Ignora grupos, estados, canales y eventos que no son mensajes.\nconst out = [];\nfor (const item of $input.all()) {\n  const b = item.json.body || item.json;\n  if (b.event !== 'messages.upsert') continue;\n  const d = Array.isArray(b.data) ? b.data[0] : b.data;\n  if (!d || !d.key) continue;\n  let jid = d.key.remoteJid || '';\n  if (!jid || jid.endsWith('@g.us') || jid.endsWith('@broadcast') || jid.endsWith('@newsletter')) continue;\n  // WhatsApp nuevo puede mandar ids \"@lid\": si viene el número real, usamos ese.\n  if (jid.endsWith('@lid') && d.key.remoteJidAlt) jid = d.key.remoteJidAlt;\n  const m = d.message || {};\n  const type = d.messageType || Object.keys(m)[0] || 'desconocido';\n  let text = (m.conversation || m.extendedTextMessage?.text || m.imageMessage?.caption\n              || m.videoMessage?.caption || m.documentMessage?.caption || '').trim();\n  if (!text && !d.key.fromMe) text = `[${type}]`;\n  out.push({ json: { jid, fromMe: !!d.key.fromMe, waId: d.key.id || '', name: d.pushName || '', text, type } });\n}\nreturn out;"
      },
      "name": "Normalizar",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
