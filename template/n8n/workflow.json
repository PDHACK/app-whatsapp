    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Respuesta de Ollama (/api/chat). Cuando se agreguen tokens de IA paga,\n// se cambia el nodo anterior y esta línea (ver README, \"Pasar a IA paga\").\nlet reply = ($json.message?.content || '').replace(/<think>[\\s\\S]*?<\\/think>/g, '').trim();\nif (!reply) reply = 'Gracias por tu mensaje, en breve te respondemos.';\nreturn { json: { jid: $('Armar prompt').item.json.jid, reply } };"
      },
